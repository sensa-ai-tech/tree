{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Round 8 mutation testing — 限定 scope 才能在合理時間內跑完。一輪只測一兩個檔案。",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "src/lib/gamification/level-system.ts",
    "src/lib/gamification/xp-calculator.ts",
    "src/lib/admin-auth.ts",
    "src/lib/api/rate-limit-store.ts",
    "src/lib/observability/error-reporter.ts",
    "src/lib/gamification/spaced-rep.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "tempDirName": "stryker-tmp",
  "cleanTempDir": true,
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "stryker-tmp",
    "reports",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
